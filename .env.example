# Set these through the hosted Site runtime settings, never in browser code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-nano-banana-2.1
GENERATION_ENABLED=false
GENERATION_MONTHLY_LIMIT=5
# Billing is intentionally not enabled. Do not enable paid subscriptions until
# acquiring provider, actual tariffs, terms and verified webhooks are implemented.

