# FORMA STUDIO — server-side only. Never put API keys in browser JavaScript.
PORT=3000
# Serper.dev: 2,500 one-off free Google Image Search queries without a credit card
SERPER_API_KEY=
# Tavily may require a payment card during registration; optional fallback
# Monthly Tavily Researcher tier: https://app.tavily.com/
TAVILY_API_KEY=
# Optional paid/legacy fallback for Brave Image Search
BRAVE_SEARCH_API_KEY=
# An OpenAI-compatible image-understanding model endpoint
VISION_API_KEY=
VISION_API_BASE=https://api.openai.com/v1
VISION_MODEL=gemini-4-argon
# Fast text-only JSON formatting after the vision photo caption
VISION_TEXT_MODEL=gemini-3.8-flash
