" draggable="false">
   <img id="beforeImg" alt="Стилизация модели дома под SketchUp без элементов интерфейса программы" src="data:image/jpeg;base64," draggable="false">
   <canvas id="materialPreview" class="material-preview" aria-hidden="true"></canvas>
   <canvas id="maskOverlay" aria-hidden="true"></canvas>
   <svg id="polyOverlay" viewBox="0 0 1000 563" preserveAspectRatio="none" aria-hidden="true"></svg>
   <div class="split-guide" id="splitGuide"><span class="split-knob"><svg class="ico"><use href="#i-chevrons"/></svg></span></div>
   <input id="splitSlider" class="split-slider" type="range" min="0" max="100" value="36" aria-label="Сравнение скриншота и результата">
   <div class="viewer-overlay-top"><span class="image-tag">ЭСКИЗ / SKETCHUP-СТИЛЬ</span><span class="image-tag image-tag-dark" id="resultTag">ДЕМОНСТРАЦИЯ</span></div>
   <div class="viewer-overlay-bottom"><div><small>АРХИТЕКТУРА / ЭКСТЕРЬЕР</small><strong id="stageTitle">Резиденция 01</strong><span id="stageSubtitle">Сад и газон · Лето · День</span></div><span class="image-badge" id="stageRatio">16:9</span></div>
   <div class="no-render" id="noRender" hidden><svg class="ico"><use href="#i-image"/></svg><strong>Результата пока нет</strong><span>Настройте сцену и запустите AI-визуализацию.</span></div>
  </div>
  <div class="editor-toolbar" id="editorToolbar" hidden>
   <div class="editor-tools"><span class="editor-caption">ВЫДЕЛЕНИЕ ОБЛАСТИ</span><button class="tool-btn active" data-tool="brush" title="Добавить маску кистью"><svg class="ico"><use href="#i-brush"/></svg><span>Кисть</span></button><button class="tool-btn" data-tool="erase" title="Убрать маску"><svg class="ico"><use href="#i-eraser"/></svg><span>Ластик</span></button><button class="tool-btn" data-tool="polygon" title="Обвести полигоном"><svg class="ico"><use href="#i-poly"/></svg><span>Полигон</span></button><label class="brush-size">Размер <input id="brushSize" type="range" min="5" max="100" value="32"><output id="brushOut">32</output></label></div>
   <div class="editor-right"><button class="btn btn-quiet btn-sm" id="undoMask" title="Отменить"><svg class="ico"><use href="#i-undo"/></svg>Отменить</button><button class="btn btn-quiet btn-sm" id="clearMask" title="Очистить выделение">Очистить</button><button class="btn btn-dark btn-sm" id="finishMask"><svg class="ico"><use href="#i-check"/></svg>Готово</button></div>
  </div>
  <div class="viewer-footer"><div class="viewer-footer-head"><span class="section-label">РАКУРСЫ И ВАРИАНТЫ</span><span class="viewer-footer-note" id="resultsHint">Демонстрационный проект</span></div><div class="results-strip" id="resultsStrip"></div></div>
 </section>
 <div class="under-viewer"><div class="upload-box" id="uploadBox" role="button" tabindex="0"><div class="upload-symbol"><svg class="ico"><use href="#i-upload"/></svg></div><div><b id="uploadTitle">Загрузить скриншот проекта</b><span id="uploadSubtitle">PNG, JPG, WEBP · Archicad, SketchUp, Revit и другие</span></div><span class="upload-action">Выбрать <svg class="ico"><use href="#i-arrow"/></svg></span><input id="sourceFile" type="file" accept="image/png,image/jpeg,image/webp" hidden></div><button class="btn btn-outline" id="newAngleBtn" title="Загрузить следующий ракурс того же дома"><svg class="ico"><use href="#i-plus"/></svg>Новый ракурс</button><input id="angleFile" type="file" accept="image/png,image/jpeg,image/webp" hidden></div>
 <div class="work-note"><svg class="ico"><use href="#i-info"/></svg><span id="workNote">Вы видите пример двух состояний одного дома. Для своей модели загрузите скриншот и подключите AI на сервере.</span></div>
 <footer class="page-footer"><span>ДОМ.РЕНДЕР © 2026</span><span>DESIGNED FOR ARCHITECTS</span></footer>
</main>
<aside class="inspector" id="inspector" aria-label="Панель визуализации">
 <div class="inspector-head"><div class="inspector-kicker"><span>РАБОЧАЯ ПАНЕЛЬ / STUDIO</span><span class="no-prompts">БЕЗ ПРОМПТОВ</span></div><h2 id="panelTitle">Настройка рендера</h2><p id="panelSubtitle">Выберите ландшафт, сезон, погоду и освещение.</p><div class="tab-bar" role="tablist"><button class="tab active" data-tab="environment" role="tab" aria-selected="true"><svg class="ico"><use href="#i-sliders"/></svg><span>Настройка рендера</span></button><button class="tab" data-tab="materials" role="tab" aria-selected="false"><svg class="ico"><use href="#i-layer"/></svg><span>Смена материалов</span></button><button class="tab" data-tab="parameters" role="tab" aria-selected="false"><svg class="ico"><use href="#i-sliders"/></svg><span>Параметры</span></button></div></div>
 <div class="inspector-scroll">
<section id="environmentPanel" class="tab-panel active" role="tabpanel"><nav class="render-jump" aria-label="Разделы настройки рендера"><button type="button" class="render-jump-btn active" data-jump="environment">Окружение</button><button type="button" class="render-jump-btn" data-jump="season">Сезон</button><button type="button" class="render-jump-btn" data-jump="weather">Погода</button><button type="button" class="render-jump-btn" data-jump="time">Свет</button><button type="button" class="render-jump-btn" data-jump="plants">Растения</button></nav><div class="render-group" id="renderSection-environment"><div class="panel-section-title"><h3>Окружение участка</h3><span>10 вариантов</span></div><div class="image-options image-options-2" id="environmentOptions"></div></div><div class="render-group" id="renderSection-season"><div class="param-group"><div class="panel-section-title"><h3>Сезон</h3></div><div class="image-options image-options-4" id="seasonOptions"></div></div></div><div class="render-group" id="renderSection-weather"><div class="param-group"><div class="panel-section-title"><h3>Погода</h3></div><div class="image-options image-options-3" id="weatherOptions"></div></div></div><div class="render-group" id="renderSection-time"><div class="param-group"><div class="panel-section-title"><h3>Время суток</h3></div><div class="image-options image-options-4" id="timeOptions"></div></div></div><div class="render-group" id="renderSection-plants"><div class="param-group"><div class="panel-section-title"><h3>Растительность</h3></div><div class="image-options image-options-3" id="plantsOptions"></div></div></div><div class="panel-help"><svg class="ico"><use href="#i-lock"/></svg><span>Настройки окружения сохраняются внутри проекта и передаются AI при генерации каждого нового ракурса.</span></div></section>
  <section id="materialsPanel" class="tab-panel" role="tabpanel"><div class="panel-section-title"><h3>Части фасада</h3><span>По зонам</span></div><div class="zone-options" id="zoneOptions"></div><div class="zone-buttons"><button class="btn btn-outline" id="startMask"><svg class="ico"><use href="#i-brush"/></svg>Выделить на изображении</button><button class="btn btn-quiet" id="showMask"><svg class="ico"><use href="#i-eye"/></svg>Показать маску</button></div><label class="switch-row selection-only"><span><b>Менять только выделенную область</b><small>При AI-генерации не трогать остальную сцену</small></span><input type="checkbox" id="editSelectedOnly"><i></i></label><div class="panel-section-title with-gap"><h3>Покрытие выбранной зоны</h3><span id="selectedZoneName">Основной фасад</span></div><div class="material-tabs"><button class="subtab active" data-mtab="catalog">Каталог</button><button class="subtab" data-mtab="mine">Мои материалы <span id="mineCount">0</span></button></div><div id="catalogMaterials" class="material-grid"></div><div id="myMaterials" class="material-grid" hidden></div><button class="upload-material" id="uploadMaterialBtn"><svg class="ico"><use href="#i-plus"/></svg><span>Загрузить свой материал <small>Фото фактуры, JPG / PNG / WebP</small></span></button><input type="file" id="materialFile" accept="image/png,image/jpeg,image/webp" hidden><button class="btn btn-quiet btn-sm" id="deleteMyMaterial" hidden style="margin-top:7px;color:#8a5548">Удалить выбранный материал</button><div class="material-tune"><label>Масштаб текстуры <output id="scaleValue">100%</output><input type="range" min="30" max="250" value="100" id="textureScale"></label><label>Поворот <select id="textureRotate"><option value="0">0°</option><option value="90">90°</option><option value="180">180°</option><option value="270">270°</option></select></label></div><button class="btn btn-dark btn-block" id="tryMaterial"><svg class="ico"><use href="#i-layer"/></svg>Примерить на выделении</button><p class="mini-disclaimer">Локальная примерка показывает расположение фактуры, не заменяет AI-рендер.</p></section>
<section id="parametersPanel" class="tab-panel" role="tabpanel"><div class="param-group"><div class="panel-section-title"><h3>Качество и формат изображения</h3></div><div class="select-grid"><label>Формат <select id="ratioSelect"><option>16:9</option><option>3:2</option><option>4:3</option><option>1:1</option><option>9:16</option></select></label><label>Качество <select id="qualitySelect"><option value="medium">Стандарт</option><option value="high" selected>Высокое</option></select></label><label>Вариантов <select id="quantitySelect"><option value="1">1</option><option value="2">2</option><option value="4">4</option></select></label></div></div><div class="param-group"><div class="panel-section-title"><h3>Сохранение архитектуры</h3></div><label class="switch-row"><span><b>Фиксировать геометрию</b><small>Просить AI сохранять окна, объёмы и пропорции</small></span><input type="checkbox" id="lockGeometry" checked><i></i></label><label class="switch-row"><span><b>Единый визуальный стиль</b><small>Использовать прошлый результат как референс следующих ракурсов</small></span><input type="checkbox" id="keepReference" checked><i></i></label><p class="mini-disclaimer">Без 3D-модели совпадение окружения между ракурсами не гарантируется.</p></div></section>
 </div>
 <div class="inspector-footer"><div class="run-summary"><span id="summaryLine">Сад и газон · Лето · День</span><span id="summaryMaterial">Травертин · основной фасад</span></div><button class="btn btn-primary btn-block" id="generateBtn"><svg class="ico"><use href="#i-spark"/></svg><span id="generateText">Создать визуализацию</span><svg class="ico arrow"><use href="#i-arrow"/></svg></button><div class="usage-foot"><span id="providerFoot">Демо: AI не подключён</span><span>Только изображения · Без 3D</span></div></div>
</aside>
