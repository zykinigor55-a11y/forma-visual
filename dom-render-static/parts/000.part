<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#f5f5f2"><meta name="description" content="ДОМ.РЕНДЕР — архитектурная визуализация из скриншота. Управление окружением, светом и материалами без промптов.">
<title>ДОМ.РЕНДЕР — AI-визуализация архитектуры</title>
<style>
:root{--bg:#f4f4f1;--paper:#fff;--ink:#202623;--muted:#818781;--muted2:#a6aba6;--hair:#e2e5e0;--dark:#19231e;--dark2:#26372d;--soft:#eff2ed;--soft2:#f7f8f5;--chosen:#d6e4d5;--green:#293b30;--rail:#171c19;--shadow:0 8px 28px rgba(16,27,18,.045);--radius:8px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font:13px/1.5 Inter,"Helvetica Neue",Arial,sans-serif;-webkit-font-smoothing:antialiased}button,input,select{font:inherit}button{cursor:pointer;color:inherit}button:disabled{cursor:not-allowed;opacity:.5}button:focus-visible,input:focus-visible,select:focus-visible,[tabindex]:focus-visible{outline:2px solid #567b5f;outline-offset:2px}button,select{transition:background .16s,border-color .16s,box-shadow .16s}button:active{transform:scale(.993)}.sprite{position:absolute;width:0;height:0;overflow:hidden}.ico{height:18px;width:18px;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.logo-mark{width:30px;height:30px;stroke:currentColor;fill:none;stroke-width:1.15;stroke-linejoin:round;stroke-linecap:round}.app{min-height:100vh;max-width:2200px;margin:auto;display:grid;grid-template-columns:70px minmax(0,1fr) 367px}.rail{background:var(--rail);display:flex;flex-direction:column;align-items:center;border-right:1px solid #2e342e;padding:22px 9px 19px;position:sticky;top:0;height:100vh;z-index:50}.brand-mark{color:#e4e8df;width:48px;height:48px;border:1px solid #404942;display:grid;place-items:center}.rail-nav{display:flex;flex-direction:column;gap:9px;margin-top:75px;width:100%;align-items:center}.rail-btn{background:transparent;color:#7e8980;border:1px solid transparent;width:47px;height:47px;display:grid;place-items:center}.rail-btn:hover{color:#fff;background:#28332b}.rail-btn.active{background:#f3f5f0;color:#1b251e;border-color:#f3f5f0}.rail-bottom{margin-top:auto;display:grid;justify-items:center;gap:18px}.rail-monogram{display:grid;place-items:center;height:36px;width:36px;border:1px solid #525d54;color:#e2e7dd;font-size:10px;letter-spacing:.08em}.workspace{min-width:0;padding:30px clamp(20px,2.8vw,48px) 24px}.topline,.top-actions,.breadcrumbs,.page-intro,.viewer-toolbar,.viewer-actions,.viewer-heading,.viewer-footer-head,.under-viewer,.upload-box,.inspector-kicker,.panel-section-title,.run-summary,.usage-foot,.zone-buttons,.dialog-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.breadcrumbs{justify-content:flex-start;font-size:10px;letter-spacing:.08em;color:#929b93}.breadcrumbs b{font-weight:600;color:#29352e;letter-spacing:0}.crumb-slash{color:#b1bab2}.top-actions{gap:8px}.status{display:flex;align-items:center;gap:7px;color:#667469;border:1px solid var(--hair);padding:7px 11px;font-size:10px;white-space:nowrap;background:#eef1eb}.status-dot{height:6px;width:6px;background:#89998b}.status.ready{background:#e7f3e6;color:#305738;border-color:#c8dcc8}.status.ready .status-dot{background:#3e8c4d}.btn{border:1px solid var(--hair);background:var(--paper);display:inline-flex;align-items:center;justify-content:center;gap:9px;white-space:nowrap;min-height:43px;padding:0 16px;font-size:11px;font-weight:600;letter-spacing:.01em;border-radius:3px}.btn:hover{border-color:#869a88;background:#f8faf7}.btn .ico{height:16px;width:16px}.btn-sm{min-height:34px;padding:0 11px;font-size:10px}.btn-quiet{border-color:transparent;background:transparent;color:#5a6b60}.btn-quiet:hover{border-color:var(--hair)}.btn-dark,.btn-primary{background:var(--dark);border-color:var(--dark);color:white}.btn-dark:hover,.btn-primary:hover{background:#304336;color:#fff;border-color:#304336}.btn-primary{min-height:53px;font-size:12px;letter-spacing:.025em}.btn-primary:disabled{background:#6e7770}.btn-block{width:100%}.btn-primary .arrow{margin-left:auto}.page-intro{align-items:flex-end;padding:42px 0 26px}.eyebrow{color:#566a5c;font-weight:700;letter-spacing:.18em;font-size:9px;margin:0}.page-intro h1{font-size:clamp(28px,3vw,48px);font-weight:500;letter-spacing:-.064em;line-height:1.14;margin:12px 0 11px}.page-intro h1 span{color:#647569}.subtitle{margin:0;color:#929a92;font-size:12px}.stepper{display:flex;align-items:center;gap:9px;padding-bottom:4px;font-size:10px;color:#adb5ad;white-space:nowrap}.stepper i{width:18px;height:1px;background:#cdd4cb}.step{display:inline-flex;gap:7px;align-items:center}.step b{font-weight:500}.step.current{color:#253e2b;font-weight:650}.step.completed{color:#78907b}.viewer-card{background:var(--paper);border:1px solid var(--hair);box-shadow:var(--shadow)}.viewer-toolbar{min-height:50px;padding:0 14px}.viewer-heading{justify-content:flex-start;gap:10px;font-size:10px;color:#7e8b80}.viewer-heading b{color:#304136;letter-spacing:.08em;font-size:10px;font-weight:650}.viewer-heading .ico{width:17px;height:17px}.divider{height:14px;width:1px;background:#cfd6cc}.viewer-actions{gap:6px}.desktop-hint{color:#9ca69d;font-size:10px;margin-right:8px}.icon-button{border:1px solid var(--hair);background:white;height:32px;width:32px;display:grid;place-items:center;color:#607267}.icon-button:hover{background:var(--soft);border-color:#c2d1c2}.icon-button .ico{height:16px;width:16px}.stage{position:relative;background:#d6d8d3;aspect-ratio:1672/941;overflow:hidden;isolation:isolate;--split:36%;touch-action:pan-y}.stage>img{position:absolute;inset:0;width:100%;height:100%;object-fit:fill;display:block;user-select:none}.stage #beforeImg{clip-path:inset(0 calc(100% - var(--split)) 0 0);z-index:2}.stage #afterImg{z-index:1}.split-guide{position:absolute;left:var(--split);top:0;bottom:0;transform:translateX(-50%);background:#fff;height:100%;width:2px;z-index:7;box-shadow:0 0 5px #0004;pointer-events:none}.split-knob{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:44px;height:44px;background:#fff;color:#24332a;border-radius:50%;box-shadow:0 2px 16px #0005;display:grid;place-items:center}.split-knob .ico{height:22px;width:22px;stroke-width:2.2}.split-slider{appearance:none;-webkit-appearance:none;position:absolute;inset:0;width:100%;height:100%;opacity:0;z-index:11;cursor:ew-resize;margin:0;touch-action:pan-y}.viewer-overlay-top{position:absolute;inset:16px 15px auto;display:flex;justify-content:space-between;pointer-events:none;z-index:8}.image-tag{background:#ffffffec;border:1px solid #ffffffc9;color:#28342e;padding:7px 10px;font-size:9px;font-weight:650;letter-spacing:.06em}.image-tag-dark{color:white;background:#18201bcb;border-color:#ffffff48}.viewer-overlay-bottom{position:absolute;bottom:0;left:0;right:0;z-index:8;display:flex;align-items:end;justify-content:space-between;gap:9px;pointer-events:none;background:linear-gradient(0deg,#0e1a16b6,transparent);padding:42px 17px 15px;color:white}.viewer-overlay-bottom small{display:block;font-size:9px;letter-spacing:.11em;color:#d3d9d1;margin-bottom:4px}.viewer-overlay-bottom strong{display:block;font-size:22px;font-weight:450;letter-spacing:-.04em}.viewer-overlay-bottom span{font-size:10px;color:#e4e9e1}.viewer-overlay-bottom .image-badge{font-size:10px;border:1px solid #ffffff9f;padding:5px 8px;color:white}.no-render{position:absolute;z-index:5;inset:0 0 0 36%;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:7px;background:#28372ecc;color:#fff;padding:17px;text-align:center}.no-render[hidden]{display:none}.no-render .ico{height:30px;width:30px;margin-bottom:6px}.no-render strong{font-size:15px;font-weight:550}.no-render span{font-size:11px;color:#e7ede5;max-width:210px}.stage.edit-mode .split-slider,.stage.edit-mode .split-guide{display:none}.stage.edit-mode #beforeImg{clip-path:none!important;display:none}.stage.edit-mode .no-render{display:none}.stage.edit-mode .viewer-overlay-top,.stage.edit-mode .viewer-overlay-bottom{pointer-events:none}.stage.edit-mode #maskOverlay{pointer-events:auto;cursor:crosshair}.stage.edit-mode #polyOverlay{display:block}.stage.edit-mode #materialPreview{display:none}.stage #maskOverlay{position:absolute;z-index:9;inset:0;width:100%;height:100%;pointer-events:none;touch-action:none}.stage #materialPreview{position:absolute;z-index:4;inset:0;width:100%;height:100%;pointer-events:none}.stage #polyOverlay{display:none;position:absolute;inset:0;width:100%;height:100%;z-index:10;pointer-events:none}#polyOverlay polyline{fill:none;stroke:#feefdd;stroke-width:2;stroke-dasharray:7 5}#polyOverlay circle{fill:white;stroke:#4f6a50;stroke-width:1.5}.viewer-footer{padding:13px 14px 15px}.viewer-footer-head{margin-bottom:10px}.section-label{font-size:10px;color:#606e62;font-weight:650;letter-spacing:.12em}.viewer-footer-note{font-size:10px;color:#99a59b}.results-strip{display:flex;gap:8px;overflow-x:auto;scrollbar-width:thin;min-height:62px}.result-thumb{flex:0 0 105px;border:1px solid #dfe4dc;background:white;padding:3px;text-align:left}.result-thumb.active{border-color:#2b4933;box-shadow:0 0 0 1px #2b4933}.result-thumb img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block}.result-thumb span{display:block;font-size:9px;color:#68796c;padding:4px 1px 1px;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}.editor-toolbar{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;gap:8px;flex-wrap:wrap;background:#eff3ed;border-bottom:1px solid #d7e1d6}.editor-toolbar[hidden]{display:none}.editor-tools,.editor-right{display:flex;align-items:center;gap:5px;flex-wrap:wrap}.editor-caption{font-size:9px;color:#5f7464;font-weight:650;margin-right:6px;letter-spacing:.06em}.tool-btn{background:white;border:1px solid #d4ddd2;height:32px;display:inline-flex;align-items:center;gap:5px;padding:0 8px;font-size:10px}.tool-btn .ico{width:14px;height:14px}.tool-btn.active{background:#22382a;border-color:#22382a;color:white}.brush-size{margin-left:6px;display:flex;align-items:center;gap:5px;font-size:10px;color:#647266}.brush-size input{width:72px;accent-color:#2d5135}.brush-size output{min-width:19px}.under-viewer{margin-top:15px;align-items:stretch;gap:10px}.upload-box{flex:1;min-width:0;justify-content:flex-start;border:1px dashed #c6d0c4;background:#fafbf9;min-height:80px;padding:10px 13px;cursor:pointer;transition:background .2s}.upload-box:hover,.upload-box.dragging{background:#e9f0e8;border-color:#67846a}.upload-symbol{height:44px;width:44px;background:#e9efe8;display:grid;place-items:center;color:#3b5a42;flex-shrink:0}.upload-box>div:nth-child(2){display:flex;flex-direction:column;gap:3px;min-width:0}.upload-box b{font-size:12px;font-weight:630}.upload-box span{font-size:10px;color:#8a958b}.upload-box .upload-action{margin-left:auto;display:flex;align-items:center;gap:6px;color:#283f2f;font-weight:650;font-size:11px}.upload-action .ico{width:15px;height:15px}.under-viewer>.btn{min-width:135px}.work-note{display:flex;gap:8px;color:#879489;font-size:10px;line-height:1.6;margin:15px 0 24px}.work-note .ico{height:15px;width:15px;flex:none}.page-footer{border-top:1px solid #dfe4db;display:flex;justify-content:space-between;gap:10px;padding-top:15px;color:#9fa99d;font-size:9px;letter-spacing:.08em}.inspector{background:#fcfdfa;border-left:1px solid #dfe4db;min-width:0;height:100vh;position:sticky;top:0;display:flex;flex-direction:column}.inspector-head{padding:26px 21px 0;border-bottom:1px solid var(--hair);flex-shrink:0}.inspector-kicker{font-size:9px;font-weight:650;letter-spacing:.1em;color:#6b796e}.no-prompts{color:#526654;background:#edf3ea;border:1px solid #dae4d8;letter-spacing:.02em;padding:4px 6px;font-size:9px}.inspector-head h2{margin:17px 0 2px;font-size:29px;letter-spacing:-.05em;font-weight:500}.inspector-head p{margin:0 0 20px;font-size:11px;color:#8c988c}.tab-bar{display:flex;justify-content:space-between;gap:3px}.tab{border:0;border-bottom:2px solid transparent;background:transparent;font-size:11px;color:#88958a;padding:0 2px 15px;display:flex;align-items:center;gap:6px;white-space:nowrap;min-width:0}.tab .ico{height:15px;width:15px}.tab:hover{color:#293a2d}.tab.active{color:#24382a;border-color:#283b2e;font-weight:650}.inspector-scroll{flex:1;overflow:auto;overscroll-behavior:contain;scrollbar-width:thin;padding:19px 20px 20px}.tab-panel{display:none}.tab-panel.active{display:block}.panel-section-title{gap:8px;margin-bottom:12px}.panel-section-title h3{margin:0;font-size:12px;font-weight:650;letter-spacing:-.01em}.panel-section-title span{font-size:10px;color:#a2ada1}.panel-section-title.with-gap{margin-top:22px}.image-options{display:grid;gap:9px}.image-options-2{grid-template-columns:repeat(2,minmax(0,1fr))}.image-options-3{grid-template-columns:repeat(3,minmax(0,1fr))}.image-options-4{grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}.image-option{background:#fff;border:1px solid #e0e6dc;min-width:0;display:flex;flex-direction:column;align-items:stretch;text-align:left;padding:3px;position:relative}.image-option img{display:block;width:100%;aspect-ratio:1.76;object-fit:cover;background:#d8ddd5}.image-option span{display:block;padding:6px 4px 4px;font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.2}.image-option.active{border-color:#344d37;box-shadow:0 0 0 1px #344d37}.image-option.active:after{content:'✓';position:absolute;top:7px;right:7px;height:17px;width:17px;display:grid;place-items:center;background:#263e2b;color:white;font-size:11px}.image-option:hover{border-color:#7f9880}.image-options-4 .image-option span,.image-options-3 .image-option span{font-size:9px}.image-options-4 .image-option img,.image-options-3 .image-option img{aspect-ratio:1.25}.panel-help{display:flex;gap:10px;margin-top:17px;padding:12px;background:#eff3ed;color:#637365;font-size:10px}.panel-help .ico{width:17px;height:17px;flex:none}.zone-options{display:flex;flex-direction:column;gap:6px}.zone-option{display:flex;align-items:center;gap:10px;width:100%;padding:7px;border:1px solid var(--hair);background:white;text-align:left}.zone-option.active{border-color:#34573a;background:#f0f5ef}.zone-option img{width:43px;height:39px;object-fit:cover}.zone-option span{display:flex;flex-direction:column;gap:1px;flex:1;min-width:0}.zone-option b{font-size:11px;font-weight:600}.zone-option small{font-size:9px;color:#89978a}.zone-option .ico{color:#315338;width:15px;height:15px}.zone-buttons{margin:10px 0 4px;gap:6px}.zone-buttons .btn{padding:0 8px;white-space:normal;font-size:10px;flex:1;line-height:1.25;min-height:41px}.zone-buttons .btn:first-child{flex:1.5}.material-tabs{display:flex;gap:15px;border-bottom:1px solid var(--hair);margin-bottom:11px}.subtab{padding:0 0 9px;border:0;border-bottom:2px solid transparent;background:transparent;color:#8d988c;font-size:11px}.subtab.active{border-color:#2e4b33;color:#26392a;font-weight:650}.subtab span{font-size:9px;margin-left:3px}.material-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.material-grid[hidden]{display:none}.material-option{border:1px solid var(--hair);background:white;padding:3px;text-align:left;min-width:0;position:relative}.material-option img{width:100%;aspect-ratio:1.36;object-fit:cover;display:block;background:#dee4dc}.material-option span{display:block;font-size:9px;padding:5px 2px 3px;text-overflow:ellipsis;white-space:nowrap;overflow:hidden}.material-option.active{border-color:#3a5c40;box-shadow:0 0 0 1px #3a5c40}.material-option.active:after{content:'✓';position:absolute;right:5px;top:5px;background:#2c4532;color:white;width:16px;height:16px;display:grid;place-items:center;font-size:10px}.material-option:hover{border-color:#86a089}.upload-material{width:100%;margin-top:10px;background:#f5f7f3;border:1px dashed #bdcdbb;min-height:54px;display:flex;gap:9px;align-items:center;padding:10px;text-align:left;color:#3d5942}.upload-material:hover{background:#eaf0e7}.upload-material .ico{width:22px;height:22px}.upload-material span{font-size:10px;font-weight:650}.upload-material small{display:block;color:#91a091;font-size:9px;font-weight:400}.material-tune{padding:14px 0;display:flex;gap:12px}.material-tune label{font-size:10px;color:#586b5a;flex:1;min-width:0;display:flex;flex-direction:column;gap:6px}.material-tune output{float:right;color:#273e2d}.material-tune input[type=range]{width:100%;accent-color:#35523a;margin:2px 0}.material-tune select{border:1px solid var(--hair);background:white;padding:7px;width:100%;font-size:11px}.mini-disclaimer{font-size:9px;color:#97a397;line-height:1.5;margin:8px 0}.param-group{padding-bottom:16px;margin-bottom:16px;border-bottom:1px solid var(--hair)}.param-group:last-child{border:0}.param-group .panel-section-title{margin-bottom:11px}.select-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.select-grid label{font-size:10px;color:#788779;display:flex;flex-direction:column;gap:6px}.select-grid select{border:1px solid #dce4da;background:white;height:39px;color:#26382d;padding:0 9px;font-size:11px;min-width:0}.switch-row{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:10px 0;cursor:pointer}.switch-row span{display:flex;flex-direction:column;gap:3px;flex:1}.switch-row b{font-weight:600;font-size:11px}.switch-row small{font-size:9px;color:#95a094;line-height:1.4}.switch-row input{appearance:none;width:35px;height:20px;border-radius:20px;background:#ccd4cb;cursor:pointer;position:relative;flex:none;transition:background .2s}.switch-row input:after{content:'';width:14px;height:14px;background:white;border-radius:50%;position:absolute;left:3px;top:3px;transition:transform .2s;box-shadow:0 1px 3px #0002}.switch-row input:checked{background:#284e32}.switch-row input:checked:after{transform:translateX(15px)}.inspector-footer{padding:15px 20px 20px;background:#fff;border-top:1px solid var(--hair);box-shadow:0 -8px 15px #f5f7f477;flex-shrink:0}.run-summary{font-size:10px;color:#4c6652;align-items:start;gap:2px;flex-direction:column;margin-bottom:12px}.run-summary span:last-child{font-size:9px;color:#9ca89b}.usage-foot{font-size:9px;color:#9ba99c;margin-top:9px;gap:6px;flex-wrap:wrap}.mobile-header,.mobile-nav{display:none}.dialog-cover{position:fixed;inset:0;background:#111c14b3;z-index:110;display:grid;place-items:center;padding:20px;overflow:auto}.dialog-cover[hidden]{display:none}.dialog{background:white;padding:24px;width:min(560px,100%);max-height:90vh;overflow:auto;box-shadow:0 22px 65px #0003}.dialog-head{align-items:flex-start;margin-bottom:15px}.dialog-head h2{font-weight:550;letter-spacing:-.04em;font-size:26px;margin:5px 0}.dialog .muted{font-size:12px;color:#738073;line-height:1.55}.dialog input[type=text],.dialog input[type=number]{height:42px;border:1px solid #d6dfd4;width:100%;padding:0 11px;outline-color:#54755b;background:white}.dialog label{display:block;color:#5d6c5e;font-size:11px;margin-bottom:10px}.dialog label input{display:block;margin-top:6px}.dialog .dialog-actions{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end;margin-top:18px}.dialog .project-list{display:flex;flex-direction:column;gap:6px;max-height:300px;overflow:auto}.dialog .project-item{display:flex;gap:8px;align-items:center;border:1px solid var(--hair);padding:10px}.dialog .project-item.active{border-color:#3e6b44;background:#f0f7ef}.dialog .project-item button:first-child{flex:1;text-align:left;background:none;border:0}.dialog .project-item b{display:block;font-size:12px}.dialog .project-item small{font-size:10px;color:#9aa99a}.dialog .project-item .icon-button{flex:none}.dialog pre{white-space:pre-wrap;overflow:auto;max-height:250px;background:#f2f4ef;padding:12px;font-size:10px;color:#526454}.toast{position:fixed;bottom:28px;left:50%;transform:translate(-50%,20px);background:#243b2b;color:white;z-index:120;padding:13px 19px;max-width:min(500px,90vw);font-size:12px;box-shadow:0 10px 35px #0002;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:1370px){.app{grid-template-columns:62px minmax(0,1fr) 335px}.workspace{padding:23px 22px 20px}.inspector-head{padding:22px 16px 0}.inspector-scroll{padding:17px 15px}.inspector-footer{padding:12px 15px 16px}.page-intro{padding-top:36px}.page-intro h1{font-size:36px}.stepper{display:none}.image-options-4{gap:4px}.inspector-head h2{font-size:25px}}
@media(max-width:1050px){.app{grid-template-columns:62px minmax(0,1fr)}.rail{grid-row:1/span 2;grid-column:1}.workspace{grid-column:2;grid-row:1;padding:24px 28px}.inspector{grid-column:2;grid-row:2;position:static;height:auto;min-height:0;border-left:0;border-top:1px solid var(--hair);display:block}.inspector-head{padding:22px 28px 0}.inspector-head h2{font-size:26px}.inspector-scroll{overflow:visible;padding:20px 28px}.inspector-footer{position:sticky;bottom:0;z-index:20;padding:14px 28px;background:#fff}.image-options-2{grid-template-columns:repeat(5,minmax(0,1fr))}.image-options-3{grid-template-columns:repeat(5,minmax(0,1fr))}.image-options-4{grid-template-columns:repeat(4,minmax(0,1fr))}.material-grid{grid-template-columns:repeat(5,minmax(0,1fr))}.zone-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.page-intro h1{font-size:39px}.param-group .image-option img{aspect-ratio:1.4}}
@media(max-width:700px){.mobile-header{display:flex;align-items:center;justify-content:space-between;gap:10px;background:#fcfdfa;border-bottom:1px solid var(--hair);height:58px;padding:0 15px;position:sticky;top:0;z-index:60}.mobile-brand{display:flex;align-items:center;gap:9px;font-size:13px;letter-spacing:.09em}.mobile-brand .logo-mark{width:25px;height:25px}.mobile-brand span{color:#78917b}.mobile-brand b{font-weight:650}.mobile-nav{position:fixed;bottom:0;left:0;right:0;height:calc(64px + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);display:flex;justify-content:space-around;align-items:center;background:#fcfdfa;border-top:1px solid #dce4da;z-index:80}.mobile-nav button{height:55px;flex:1;border:0;background:transparent;color:#98a49a;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-size:9px}.mobile-nav button.active{color:#24412d;font-weight:700}.mobile-nav .ico{height:19px;width:19px}.app{display:block;padding-bottom:calc(72px + env(safe-area-inset-bottom))}.rail{display:none}.workspace{padding:0 14px 21px}.topline{padding-top:16px;gap:6px}.breadcrumbs{font-size:9px}.top-actions .btn{padding:0 8px;min-height:32px}.top-actions .btn span{display:none}.top-actions .status{font-size:9px;padding:6px 8px}.page-intro{display:block;padding:30px 0 20px}.page-intro h1{font-size:32px;letter-spacing:-.055em}.page-intro .subtitle{font-size:11px;max-width:370px}.viewer-toolbar{min-height:43px;padding:0 9px}.viewer-heading .divider,.viewer-heading>span:last-child,.desktop-hint{display:none}.viewer-heading b{font-size:9px}.viewer-actions .icon-button{height:29px;width:29px}.stage{min-height:220px;aspect-ratio:1.48}.stage>img{object-fit:cover}.stage #beforeImg{object-fit:cover}.viewer-overlay-top{inset:9px 8px auto}.image-tag{font-size:8px;padding:5px 6px}.viewer-overlay-bottom{padding:30px 9px 8px}.viewer-overlay-bottom small{font-size:8px}.viewer-overlay-bottom strong{font-size:17px}.viewer-overlay-bottom span{font-size:9px}.split-knob{width:38px;height:38px}.viewer-footer{padding:10px}.results-strip{gap:7px}.result-thumb{flex-basis:98px}.under-viewer{margin-top:11px;gap:8px}.upload-box{min-height:73px;padding:8px;gap:8px}.upload-symbol{width:38px;height:38px}.upload-box b{font-size:10px}.upload-box>div:nth-child(2) span{font-size:9px;line-height:1.2}.upload-box .upload-action{display:none}.under-viewer>.btn{font-size:0;min-width:47px;width:47px;padding:0;flex:none}.under-viewer>.btn .ico{height:20px;width:20px}.work-note{margin-bottom:18px}.page-footer{padding-bottom:10px}.inspector-head{padding:21px 14px 0}.inspector-head h2{font-size:24px;margin-top:13px}.inspector-scroll{padding:15px 14px}.image-options-2{grid-template-columns:repeat(2,minmax(0,1fr))}.image-options-3{grid-template-columns:repeat(3,minmax(0,1fr))}.image-options-4{grid-template-columns:repeat(4,minmax(0,1fr))}.material-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.inspector-footer{bottom:calc(64px + env(safe-area-inset-bottom));padding:10px 14px 12px;box-shadow:0 -6px 20px #0000000a}.inspector-footer .btn-primary{min-height:48px}.usage-foot{display:none}.dialog-cover{padding:10px}.dialog{padding:17px}.editor-toolbar{padding:8px}.editor-tools{gap:3px}.editor-caption{width:100%}.tool-btn span{display:none}.brush-size{margin-left:1px}.editor-right .btn{padding:0 8px}.toast{bottom:calc(82px + env(safe-area-inset-bottom))}}
@media(max-width:375px){.top-actions .status{display:none}.page-intro h1{font-size:29px}.tab{font-size:10px;gap:4px}.tab .ico{height:13px;width:13px}.image-options-4{grid-template-columns:repeat(2,minmax(0,1fr))}.editor-right .btn{font-size:9px}.inspector-kicker{font-size:8px}}
/* Keep the responsive preview inside narrow viewports, even with a fixed image aspect ratio. */
@media(max-width:700px){.stage{min-height:0;width:100%}}

.selection-only{border:1px solid #dce6db;background:#f6f9f5;padding:10px;margin-top:12px}.selection-only b{font-size:10px}

.stage #materialPreview{clip-path:inset(0 0 0 var(--split))}

/* Navigation v2: scene settings together, material changes separate. */
.tab-bar{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;}
.tab{width:100%;min-width:0;min-height:58px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;padding:7px 2px 10px;text-align:center;line-height:1.15;white-space:normal;font-size:10px;}
.tab .ico{height:16px;width:16px;}
.tab span{display:block;max-width:100%;text-wrap:balance;}
.render-jump{position:sticky;top:-19px;z-index:10;display:flex;gap:5px;overflow-x:auto;scrollbar-width:none;align-items:center;margin:-19px -20px 18px;padding:13px 20px 12px;background:#fcfdfa;border-bottom:1px solid var(--hair);}
.render-jump::-webkit-scrollbar{display:none;}
.render-jump-btn{border:1px solid #dbe4da;background:white;color:#718073;flex:0 0 auto;font-size:10px;white-space:nowrap;padding:8px 11px;border-radius:2px;}
.render-jump-btn:hover{border-color:#8b9c8b;color:#283a2c;}
.render-jump-btn.active{background:#243a2a;border-color:#243a2a;color:white;}
.render-group{scroll-margin-top:64px;}
.render-group:not(:first-of-type){padding-top:16px;margin-top:18px;border-top:1px solid var(--hair);}
.render-group .param-group{padding-bottom:0;margin-bottom:0;border-bottom:0;}
.render-group .panel-section-title{margin-bottom:11px;}
@media(max-width:1370px){.render-jump{margin-left:-15px;margin-right:-15px;padding-left:15px;padding-right:15px;top:-17px}.tab{min-height:59px;font-size:9.6px}.tab .ico{width:15px;height:15px;}}
@media(max-width:1050px){.render-jump{position:sticky;top:0;margin:-20px -28px 18px;padding:12px 28px;background:#fcfdfa}.render-group{scroll-margin-top:90px}}
@media(max-width:700px){.render-jump{top:58px;margin:-15px -14px 16px;padding:10px 14px}.render-group{scroll-margin-top:124px}.tab{min-height:55px;font-size:10px}.tab .ico{height:15px;width:15px}}

/* All five render section shortcuts fit even in the narrow desktop inspector. */
.render-jump{gap:4px;} .render-jump-btn{padding:8px 7px;font-size:9.5px;}

/* v3: larger, clearer photographic choice cards */
.image-option img{image-rendering:auto;object-position:center;aspect-ratio:1.6}
.image-options-4{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
.image-options-3{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
.image-options-3 .image-option img,.image-options-4 .image-option img{aspect-ratio:1.76}
.image-options-3 .image-option span,.image-options-4 .image-option span{font-size:10px}
.image-option{padding:4px;border-color:#dce4db}
.image-option:hover{border-color:#456b51}
@media(min-width:701px) and (max-width:1050px){.image-options-4{grid-template-columns:repeat(4,minmax(0,1fr))}.image-options-3{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:700px){.image-options-2,.image-options-3,.image-options-4{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.image-option img{aspect-ratio:1.7}}

</style>
</head>
<body>
<svg class="sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
 <symbol id="i-house" viewBox="0 0 24 24"><path d="M3 21V9l9-6 9 6v12M3 9l9 6 9-6M12 15v6M8 21v-7"/></symbol>
 <symbol id="i-spark" viewBox="0 0 24 24"><path d="m12 2 1.7 6.3L20 10l-6.3 1.7L12 18l-1.7-6.3L4 10l6.3-1.7L12 2ZM19 17l.6 2.4L22 20l-2.4.6L19 23l-.6-2.4L16 20l2.4-.6L19 17Z"/></symbol>
 <symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v10H3V7Z"/></symbol>
 <symbol id="i-image" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8" cy="8" r="1.5"/><path d="m21 16-5-5-9 10"/></symbol>
 <symbol id="i-layer" viewBox="0 0 24 24"><path d="m12 2 10 6-10 6L2 8l10-6Zm-10 11 10 6 10-6M2 18l10 5 10-5"/></symbol>
 <symbol id="i-sliders" viewBox="0 0 24 24"><path d="M4 7h16M4 17h16M8 3v8m8 2v8"/></symbol>
 <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></symbol>
 <symbol id="i-tree" viewBox="0 0 24 24"><path d="m7 4-5 9h4l-3 5h18l-3-5h4l-5-9-5 9-5-9ZM12 18v4"/></symbol>
 <symbol id="i-cloud" viewBox="0 0 24 24"><path d="M7 18a5 5 0 1 1 1.3-9.8A6 6 0 0 1 20 10a4 4 0 0 1-1 8H7Z"/></symbol>
 <symbol id="i-check" viewBox="0 0 24 24"><path d="m4 12 5 5L20 6"/></symbol>
 <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 4v16M4 12h16"/></symbol>
 <symbol id="i-upload" viewBox="0 0 24 24"><path d="M12 16V3m-5 5 5-5 5 5M4 17v4h16v-4"/></symbol>
 <symbol id="i-down" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></symbol>
 <symbol id="i-download" viewBox="0 0 24 24"><path d="M12 3v13m-5-5 5 5 5-5M4 17v4h16v-4"/></symbol>
 <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M4 12h16m-6-6 6 6-6 6"/></symbol>
 <symbol id="i-chevrons" viewBox="0 0 24 24"><path d="m8 7-5 5 5 5m8-10 5 5-5 5"/></symbol>
 <symbol id="i-undo" viewBox="0 0 24 24"><path d="m9 14-5-5 5-5M4 9h10a6 6 0 0 1 0 12"/></symbol>
 <symbol id="i-trash" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2m3 0-1 15H6L5 6m5 4v7m4-7v7"/></symbol>
 <symbol id="i-brush" viewBox="0 0 24 24"><path d="m14 4 6 6-9 9-6 1 1-6 8-10ZM3 20h6"/></symbol>
 <symbol id="i-poly" viewBox="0 0 24 24"><path d="m5 5 13-2 3 15-13 3L5 5Z"/><circle cx="5" cy="5" r="1.5"/><circle cx="18" cy="3" r="1.5"/><circle cx="21" cy="18" r="1.5"/><circle cx="8" cy="21" r="1.5"/></symbol>
 <symbol id="i-eraser" viewBox="0 0 24 24"><path d="m9 4 11 11-6 6H8L2 15 13 4a3 3 0 0 1 4 0l3 3M8 21h14"/></symbol>
 <symbol id="i-lock" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="11" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></symbol>
 <symbol id="i-copy" viewBox="0 0 24 24"><rect x="8" y="8" width="13" height="13" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/></symbol>
 <symbol id="i-x" viewBox="0 0 24 24"><path d="M5 5 19 19M19 5 5 19"/></symbol>
 <symbol id="i-full" viewBox="0 0 24 24"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m8 0h5v-5"/></symbol>
 <symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 11v6m0-10v.1"/></symbol>
 <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></symbol>
 <symbol id="i-reload" viewBox="0 0 24 24"><path d="M20 7v5h-5M4 17v-5h5M5 9a8 8 0 0 1 14-2l1 5M4 12l1 5a8 8 0 0 0 14-2"/></symbol>
 <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></symbol>
 <symbol id="i-save" viewBox="0 0 24 24"><path d="M4 3h13l4 4v14H3V3h1Zm3 0v7h10V3M7 21v-8h10v8"/></symbol>
</svg>
<header class="mobile-header"><div class="mobile-brand"><svg class="logo-mark"><use href="#i-house"/></svg><b>ДОМ<span>.</span>РЕНДЕР</b></div><button class="btn btn-outline btn-sm" id="mobileAdd"><svg class="ico"><use href="#i-plus"/></svg>Проект</button></header>
<div class="app" id="app">
<aside class="rail" aria-label="Основная навигация">
 <div class="brand-mark" title="ДОМ.РЕНДЕР"><svg class="logo-mark"><use href="#i-house"/></svg></div>
 <nav class="rail-nav">
  <button class="rail-btn active" data-nav="studio" title="Студия" aria-label="Студия"><svg class="ico"><use href="#i-spark"/></svg></button>
  <button class="rail-btn" data-nav="projects" title="Мои проекты" aria-label="Мои проекты"><svg class="ico"><use href="#i-folder"/></svg></button>
  <button class="rail-btn" data-nav="environment" title="Настройка рендера" aria-label="Настройка рендера"><svg class="ico"><use href="#i-tree"/></svg></button>
  <button class="rail-btn" data-nav="materials" title="Смена материалов" aria-label="Смена материалов"><svg class="ico"><use href="#i-layer"/></svg></button>
  <button class="rail-btn" data-nav="parameters" title="Параметры" aria-label="Параметры"><svg class="ico"><use href="#i-sliders"/></svg></button>
 </nav>
 <div class="rail-bottom"><button class="rail-btn" id="helpBtn" title="Как работает сервис" aria-label="Помощь"><svg class="ico"><use href="#i-info"/></svg></button><span class="rail-monogram">DR</span></div>
</aside>
<main class="workspace" id="workspace">
 <div class="topline"><div class="breadcrumbs"><span>ДОМ.РЕНДЕР</span><span class="crumb-slash">/</span><b id="breadcrumbName">Резиденция 01</b></div><div class="top-actions"><span class="status" id="apiStatus"><span class="status-dot"></span>Демо-режим</span><button class="btn btn-outline btn-sm" id="briefBtn" title="Скопировать настройки"><svg class="ico"><use href="#i-copy"/></svg><span>Бриф</span></button><button class="btn btn-outline btn-sm" id="newProjectBtn"><svg class="ico"><use href="#i-plus"/></svg><span>Новый проект</span></button></div></div>
 <div class="page-intro"><div><p class="eyebrow">AI-СТУДИЯ ДЛЯ АРХИТЕКТОРОВ</p><h1>Из проекта. <span>В фотографию.</span></h1><p class="subtitle">Скриншот дома → окружение, свет и материалы → архитектурное фото.</p></div><div class="stepper"><span class="step completed">01 <b>Проект</b></span><i></i><span class="step current">02 <b>Настройка</b></span><i></i><span class="step">03 <b>Результат</b></span></div></div>
 <section class="viewer-card" aria-label="Просмотр проекта">
  <div class="viewer-toolbar"><div class="viewer-heading"><svg class="ico"><use href="#i-image"/></svg><b>РАБОЧИЙ ХОЛСТ</b><span class="divider"></span><span id="canvasProjectLabel">Резиденция 01</span></div><div class="viewer-actions"><span class="desktop-hint">Переместите ползунок для сравнения</span><button class="icon-button" id="downloadResult" title="Скачать выбранный результат" aria-label="Скачать изображение"><svg class="ico"><use href="#i-download"/></svg></button><button class="icon-button" id="resetSplit" title="Сравнить 50/50" aria-label="Сравнить пополам"><svg class="ico"><use href="#i-chevrons"/></svg></button><button class="icon-button" id="fullBtn" title="Развернуть" aria-label="Развернуть"><svg class="ico"><use href="#i-full"/></svg></button></div></div>
  <div class="stage" id="stage" style="--split:36%">
   <img id="afterImg" alt="Демонстрационная фотореалистичная визуализация" src="data:image/jpeg;base64,